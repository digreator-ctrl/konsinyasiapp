{
  "name": "konsinyasi-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "konsinyasi-db",
      // Local dev works with this placeholder. For production, create the
      // database with `wrangler d1 create konsinyasi-db` and paste its real id.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "konsinyasi-media"
    }
  ],
  // Non-secret variables only. Secrets such as BETTER_AUTH_SECRET live in
  // `.dev.vars` for local dev and in `wrangler secret put` for production.
  "vars": {
    "BETTER_AUTH_URL": "http://localhost:8787",
    "FRONTEND_URL": "http://localhost:5173"
  }
}
